# ---------- Build stage ----------
    FROM node:20-alpine AS build
    WORKDIR /app
    
    # Install dependencies
    COPY package*.json ./
    RUN npm ci --no-audit
    
    # Copy project files and build the production bundle
    COPY . .
    RUN npm run build
    
    # ---------- Serve stage ----------
    FROM nginx:alpine
    COPY --from=build /app/dist /usr/share/nginx/html
    EXPOSE 80
    